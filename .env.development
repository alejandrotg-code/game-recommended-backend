# ── Desarrollo ──────────────────────────────────────────────

# Entorno (development | production)
ENV=development

# Logging (DEBUG en dev, WARNING en prod)
LOG_LEVEL=DEBUG

# CORS — permite el frontend local de Vite
CORS_ORIGINS=http://localhost:5173

# Rate limit — permisivo para desarrollo
RATE_LIMIT=100
RATE_WINDOW=60

# Groq Cloud API Key
GROQ_API_KEY=your_api_key

# Qdrant Cloud Cluster URL & API Key
QDRANT_URL=your_url_qdrant
QDRANT_API_KEY=your_api_key


# Puerto del servidor (opcional, uvicorn lo usa si se pasa --port)
PORT=8000
